{
  // Worker que sirve la web estática (dist/) y un único endpoint: POST /api/contact.
  // Docs: https://developers.cloudflare.com/workers/static-assets/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alumhost-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Solo /api/* pasa por el Worker; todo lo demás lo sirve Static Assets directamente (gratis y rápido).
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Solo alumhost.dev: sin la URL *.workers.dev (evita una segunda puerta con otro origen).
  "workers_dev": false,

  // Rate limit del formulario: 5 envíos por minuto por IP (threat model, fase 2).
  "ratelimits": [
    { "name": "CONTACT_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    // Publish: peticiones autenticadas por sitio (subida de trozos, fetch, finish...). El cliente reintenta si llega al tope.
    { "name": "PUBLISH_LIMITER", "namespace_id": "1003", "simple": { "limit": 300, "period": 60 } }
  ],

  // Dominio propio: Cloudflare crea los registros DNS y el certificado al desplegar.
  "routes": [
    { "pattern": "alumhost.dev", "custom_domain": true },
    { "pattern": "www.alumhost.dev", "custom_domain": true }
  ],

  // Variables NO secretas. Secretos (no van en el repo, que es público):
  //   npx wrangler secret put TURNSTILE_SECRET   -> secret key de Turnstile
  //   npx wrangler secret put CONTACT_TO         -> correos VERIFICADOS en Email Routing, separados por comas (destino del formulario)
  "vars": {
    "CONTACT_FROM": "web@alumhost.dev", // remitente en alumhost.dev (Email Routing activo)
    "MAIL_FROM": "hola@alumhost.dev", // remitente de los correos a clientes (dominio verificado en Brevo)
    "MAIL_REPLY_TO": "soporte@alumhost.dev" // las respuestas de los clientes van aquí
  },

  // Correos programados de Publish (worker/publish-lifecycle.ts): una vez al día, a las 8:00 UTC.
  "triggers": { "crons": ["0 8 * * *"] },

  // Envío de correo con Email Routing. Sin destination_address: puede enviar a cualquier dirección
  // verificada en Email Routing → Destination addresses; el destino concreto es el secreto CONTACT_TO.
  "send_email": [{ "name": "CONTACT_MAILER" }],

  // Publish gratis (worker/publish.ts). Misma D1 que el Worker que sirve los sitios (sites/wrangler.jsonc).
  // Base de datos D1 "alumhost-publish" creada el 30/09/2026 con jurisdicción UE (RGPD); el id va abajo y en sites/wrangler.jsonc.
  // Tablas:          npx wrangler d1 migrations apply alumhost-publish --remote
  // Secreto:        npx wrangler secret put BREVO_API_KEY   (clave API de Brevo, para todos los correos a clientes)
  "d1_databases": [
    { "binding": "PUBLISH_DB", "database_name": "alumhost-publish", "database_id": "34c625b4-5465-4883-9611-0ed7111ce381", "migrations_dir": "migrations" }
  ]
}
