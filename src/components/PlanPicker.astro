---
/**
 * Selector de plan del hero. Componente real (no maqueta): cambia de plan sin JS usando :has().
 * Es el ÚNICO elemento de cristal de la web: flota sobre el agua del hero. Está pensado para vivir dentro de
 * una banda .band-anil (hereda color, --muted, --btn-*).
 * Muestra precio anual con IVA prorrateado por mes. Enlaza a la fila del plan en /planes.
 */
import { plans } from "../config/plans";
import { priceView, specLines } from "../lib/planText";
import { path, useDict, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useDict(lang);
const pk = t.home.hero.picker;
const def = plans.find((p) => p.featured)?.id ?? plans[0].id;
---
<fieldset class="picker glass">
  <legend class="legend">{pk.legend}</legend>
  <div class="options">
    {plans.map((p) => (
      <label class="opt">
        <input type="radio" name="hero-plan" value={p.id} checked={p.id === def} />
        <span>{pk.options[p.id]}</span>
      </label>
    ))}
  </div>

  <div class="panels" aria-live="polite">
    {plans.map((p) => {
      const price = priceView(p, "yearly", lang);
      return (
        <div class="panel" data-plan={p.id}>
          <p class="name">{t.plans.items[p.id].name}</p>
          <ul class="specs mono">
            {specLines(p, lang).slice(0, 3).map((line) => <li>{line}</li>)}
          </ul>
          <p class="price">
            <span class="amount">{price.monthly}</span>
            <span class="per">{t.common.perMonth}</span>
          </p>
          <p class="note">{price.note}</p>
          <a class="more textlink" href={`${path("plans", lang)}#${p.id}`}>{pk.details}</a>
        </div>
      );
    })}
  </div>
</fieldset>

<style>
  .picker {
    padding: clamp(1.2rem, 2.5vw, 1.8rem);
    min-width: 0;
  }
  .legend {
    float: left; /* saca el legend del borde del fieldset */
    width: 100%;
    font-weight: 600;
    margin-bottom: 0.9rem;
  }
  .options { clear: both; display: grid; }
  .opt { position: relative; border-top: 1px solid rgb(255 255 255 / 0.3); }
  .opt:last-child { border-bottom: 1px solid rgb(255 255 255 / 0.3); }
  .opt input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .opt span {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: 0.4rem 0.9rem;
    font-weight: 600;
    transition: background-color 160ms var(--ease), color 160ms var(--ease);
  }
  .opt:hover span { background: rgb(255 255 255 / 0.1); }
  .opt input:checked + span { background: var(--albero); color: var(--ink); }
  .opt input:focus-visible + span { outline: 3px solid var(--white); outline-offset: -3px; }

  .panels { margin-top: 1.3rem; }
  .panel { display: none; }
  .picker:has(input[value="publish"]:checked) .panel[data-plan="publish"],
  .picker:has(input[value="developer"]:checked) .panel[data-plan="developer"],
  .picker:has(input[value="pro"]:checked) .panel[data-plan="pro"] {
    display: block;
    animation: swap 380ms var(--ease);
  }
  /* Navegadores sin :has(): se ve el plan destacado */
  @supports not selector(:has(*)) {
    .panel[data-plan="developer"] { display: block; }
  }
  @keyframes swap {
    from { opacity: 0; transform: translateY(5px); }
  }

  .name { font-weight: 600; color: var(--muted); }
  .specs {
    list-style: none;
    padding: 0;
    margin-top: 0.3rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1rem;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .price { margin-top: 0.9rem; display: flex; align-items: baseline; gap: 0.3rem; }
  .amount {
    font-family: var(--font-display);
    font-stretch: 68%;
    font-weight: 800;
    font-size: var(--step-3);
    line-height: 0.9;
    font-variant-numeric: tabular-nums;
  }
  .per { color: var(--muted); }
  .note { font-size: var(--step--1); margin-top: 0.4rem; color: var(--muted); }
  .more { display: inline-flex; align-items: center; margin-top: 0.7rem; min-height: 44px; }
</style>
