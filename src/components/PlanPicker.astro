---
/**
 * Selector de plan del hero. Componente real (no maqueta): cambia de plan sin JS usando :has().
 * Muestra precio anual con IVA prorrateado por mes. Enlaza a la tarjeta del plan en /planes.
 */
import Icon from "./Icon.astro";
import { plans } from "../config/plans";
import { priceView, specLines } from "../lib/planText";
import { path, useDict, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useDict(lang);
const pk = t.home.hero.picker;
const def = plans.find((p) => p.featured)?.id ?? plans[0].id;
---
<fieldset class="picker glass">
  <legend class="legend">{pk.legend}</legend>
  <div class="options">
    {plans.map((p) => (
      <label class="opt">
        <input type="radio" name="hero-plan" value={p.id} checked={p.id === def} />
        <span>{pk.options[p.id]}</span>
      </label>
    ))}
  </div>

  <div class="panels" aria-live="polite">
    {plans.map((p) => {
      const price = priceView(p, "yearly", lang);
      return (
        <div class="panel" data-plan={p.id}>
          <p class="name">{t.plans.items[p.id].name}</p>
          <ul class="specs mono">
            {specLines(p, lang).slice(0, 3).map((line) => <li>{line}</li>)}
          </ul>
          <p class="price">
            <span class="amount">{price.monthly}</span>
            <span class="per">{t.common.perMonth}</span>
          </p>
          <p class="note muted">{price.note}</p>
          <a class="more" href={`${path("plans", lang)}#${p.id}`}>
            {pk.details} <Icon name="arrow-right" />
          </a>
        </div>
      );
    })}
  </div>
</fieldset>

<style>
  .picker {
    border: 1px solid var(--glass-border);
    padding: 1.5rem;
    min-width: 0;
  }
  .legend {
    float: left; /* saca el legend del borde del fieldset */
    width: 100%;
    font-weight: 560;
    margin-bottom: 1rem;
  }
  .options {
    clear: both;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.35rem;
    padding: 0.3rem;
    border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--cal-hondo) 70%, transparent);
  }
  .opt { position: relative; }
  .opt input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }
  .opt span {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 44px;
    padding: 0.4rem 0.6rem;
    border-radius: var(--r-pill);
    font-size: var(--step--1);
    font-weight: 520;
    line-height: 1.2;
    color: var(--pizarra);
    transition: background-color 250ms var(--ease), color 250ms var(--ease), box-shadow 250ms var(--ease);
  }
  .opt input:checked + span {
    background: var(--glass-bg-strong);
    color: var(--tinta);
    box-shadow: inset 0 1px 0 var(--glass-highlight), 0 4px 14px -6px rgb(19 40 80 / 0.35);
  }
  .opt input:focus-visible + span { outline: 2px solid var(--azulejo); outline-offset: 2px; }

  .panels { margin-top: 1.5rem; }
  .panel { display: none; }
  .picker:has(input[value="publish"]:checked) .panel[data-plan="publish"],
  .picker:has(input[value="developer"]:checked) .panel[data-plan="developer"],
  .picker:has(input[value="pro"]:checked) .panel[data-plan="pro"] {
    display: block;
    animation: swap 450ms var(--ease);
  }
  /* Navegadores sin :has(): se ve el plan destacado */
  @supports not selector(:has(*)) {
    .panel[data-plan="developer"] { display: block; }
  }
  @keyframes swap {
    from { opacity: 0; transform: translateY(6px); }
  }

  .name { font-family: var(--font-display); font-weight: 650; font-size: var(--step-1); }
  .specs {
    list-style: none;
    padding: 0;
    margin-top: 0.6rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.82rem;
  }
  .specs li {
    padding: 0.25rem 0.65rem;
    border-radius: var(--r-pill);
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
  }
  .price { margin-top: 1.4rem; display: flex; align-items: baseline; gap: 0.25rem; }
  .amount {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .per { color: var(--pizarra); font-weight: 500; }
  .note { font-size: var(--step--1); margin-top: 0.35rem; }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 1.1rem;
    min-height: 44px;
    font-weight: 560;
    text-decoration: none;
  }
  .more:hover { text-decoration: underline; }
</style>
