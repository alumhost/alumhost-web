---
/**
 * Navegación: píldora de cristal flotante. En móvil (<820px) los enlaces pasan a un panel desplegable.
 * El CTA sale de primaryCta() (depende de site.salesMode). El cambio de idioma lleva a la misma página.
 */
import Mark from "./Mark.astro";
import Icon from "./Icon.astro";
import { site } from "../config/site";
import { primaryCta } from "../config/cta";
import { path, useDict, type Lang, type RouteKey } from "../i18n";

interface Props {
  lang: Lang;
  page: RouteKey | "notFound";
}
const { lang, page } = Astro.props;
const t = useDict(lang);
const other: Lang = lang === "es" ? "en" : "es";
const switchHref = path(page === "notFound" ? "home" : page, other);
const cta = primaryCta(lang);
const links: { key: RouteKey; label: string }[] = [
  { key: "plans", label: t.nav.plans },
  { key: "contact", label: t.nav.contact },
];
---
<header class="nav-wrap">
  <nav class="nav glass glass--strong" aria-label={t.nav.menu} data-nav>
    <a class="brand" href={path("home", lang)} aria-label={`${site.name}, ${t.nav.home}`}>
      <Mark size={26} />
      <span>{site.name}</span>
    </a>

    <div class="nav-panel" id="nav-panel">
      <ul class="links">
        {links.map((l) => (
          <li>
            <a href={path(l.key, lang)} aria-current={page === l.key ? "page" : undefined}>{l.label}</a>
          </li>
        ))}
        <li>
          <a class="lang" href={switchHref} hreflang={other} lang={other} aria-label={t.nav.switchLabel}>
            {t.nav.switchTo}
          </a>
        </li>
      </ul>
    </div>

    <div class="actions">
      <a class="btn btn--primary btn--sm" href={cta.href}>{cta.label}</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav-panel" data-menu-btn>
        <span class="sr-only" data-open-label>{t.nav.menu}</span>
        <span class="sr-only" data-close-label hidden>{t.nav.close}</span>
        <span class="icon-open"><Icon name="list" size="1.4em" /></span>
        <span class="icon-close"><Icon name="x" size="1.4em" /></span>
      </button>
    </div>
  </nav>
</header>

<style>
  .nav-wrap {
    position: fixed;
    inset: 0.9rem 0 auto;
    z-index: var(--z-nav);
    padding-inline: var(--gutter);
    pointer-events: none;
  }
  .nav {
    pointer-events: auto;
    max-width: calc(var(--max) - 2 * var(--gutter));
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 64px;
    padding: 0.5rem 0.55rem 0.5rem 1.1rem;
    border-radius: var(--r-pill);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--tinta);
    text-decoration: none;
    font-family: var(--font-display);
    font-stretch: var(--display-width);
    font-weight: 800;
    font-size: 1.2rem;
    letter-spacing: 0.01em;
  }
  .nav-panel { margin-left: auto; }
  .links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.9rem;
    border-radius: var(--r-pill);
    color: var(--tinta);
    text-decoration: none;
    font-weight: 500;
    transition: background-color 200ms var(--ease);
  }
  .links a:hover { background: var(--glass-bg); }
  .links a[aria-current="page"] { color: var(--azulejo); }
  .links .lang {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    color: var(--pizarra);
  }
  .actions { display: flex; align-items: center; gap: 0.4rem; }
  .btn--sm { min-height: 44px; padding: 0.6rem 1.1rem; }

  .menu-btn {
    display: none;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--tinta);
    align-items: center;
    justify-content: center;
  }
  .icon-close { display: none; }

  @media (max-width: 819px) {
    .nav { flex-wrap: wrap; gap: 0.5rem; border-radius: var(--r-panel); }
    .actions { margin-left: auto; order: 2; }
    .menu-btn { display: inline-flex; }
    .nav-panel {
      order: 3;
      flex-basis: 100%;
      margin: 0;
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 350ms var(--ease);
    }
    /* Cerrado: fuera del orden de tabulación y del árbol de accesibilidad (visibility), tras la animación */
    .nav-panel > .links { overflow: hidden; min-height: 0; visibility: hidden; transition: visibility 0s 350ms; }
    [data-nav].is-open .nav-panel > .links { visibility: visible; transition-delay: 0s; }
    .links { flex-direction: column; align-items: stretch; gap: 0.15rem; }
    .links a { min-height: 48px; font-size: 1.05rem; }
    [data-nav].is-open .nav-panel { grid-template-rows: 1fr; }
    [data-nav].is-open .links { padding-block: 0.25rem 0.5rem; }
    [data-nav].is-open .icon-open { display: none; }
    [data-nav].is-open .icon-close { display: inline; }
  }
  @media (max-width: 380px) {
    .brand span { display: none; }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  const btn = nav?.querySelector<HTMLButtonElement>("[data-menu-btn]");
  if (nav && btn) {
    const openLabel = btn.querySelector<HTMLElement>("[data-open-label]")!;
    const closeLabel = btn.querySelector<HTMLElement>("[data-close-label]")!;
    const set = (open: boolean) => {
      nav.classList.toggle("is-open", open);
      btn.setAttribute("aria-expanded", String(open));
      openLabel.hidden = open;
      closeLabel.hidden = !open;
    };
    btn.addEventListener("click", () => set(!nav.classList.contains("is-open")));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && nav.classList.contains("is-open")) {
        set(false);
        btn.focus();
      }
    });
    nav.querySelectorAll(".links a").forEach((a) => a.addEventListener("click", () => set(false)));
  }
</script>
