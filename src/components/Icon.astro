---
/**
 * Iconos Phosphor (regular), inline como SVG. Para añadir uno: importa su .svg?raw y añádelo a `icons`.
 * Catálogo: https://phosphoricons.com  (no dibujes SVG a mano).
 */
import arrowRight from "@phosphor-icons/core/regular/arrow-right.svg?raw";
import arrowUpRight from "@phosphor-icons/core/regular/arrow-up-right.svg?raw";
import chatCircleText from "@phosphor-icons/core/regular/chat-circle-text.svg?raw";
import graduationCap from "@phosphor-icons/core/regular/graduation-cap.svg?raw";
import gitBranch from "@phosphor-icons/core/regular/git-branch.svg?raw";
import terminalWindow from "@phosphor-icons/core/regular/terminal-window.svg?raw";
import envelopeSimple from "@phosphor-icons/core/regular/envelope-simple.svg?raw";
import warningOctagon from "@phosphor-icons/core/regular/warning-octagon.svg?raw";
import list from "@phosphor-icons/core/regular/list.svg?raw";
import x from "@phosphor-icons/core/regular/x.svg?raw";
import check from "@phosphor-icons/core/regular/check.svg?raw";
import handshake from "@phosphor-icons/core/regular/handshake.svg?raw";
import code from "@phosphor-icons/core/regular/code.svg?raw";
import receipt from "@phosphor-icons/core/regular/receipt.svg?raw";
import currencyEur from "@phosphor-icons/core/regular/currency-eur.svg?raw";
import lockSimple from "@phosphor-icons/core/regular/lock-simple.svg?raw";

const icons = {
  "arrow-right": arrowRight,
  "arrow-up-right": arrowUpRight,
  "chat-circle-text": chatCircleText,
  "graduation-cap": graduationCap,
  "git-branch": gitBranch,
  "terminal-window": terminalWindow,
  "envelope-simple": envelopeSimple,
  "warning-octagon": warningOctagon,
  list,
  x,
  check,
  handshake,
  code,
  receipt,
  "currency-eur": currencyEur,
  "lock-simple": lockSimple,
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number | string;
  class?: string;
  label?: string;
}
const { name, size = "1.25em", class: className, label } = Astro.props;
const svg = icons[name]
  .replace("<svg ", `<svg width="${size}" height="${size}" ${label ? `role="img" aria-label="${label}"` : 'aria-hidden="true" focusable="false"'} ${className ? `class="${className}"` : ""} `);
---
<Fragment set:html={svg} />
