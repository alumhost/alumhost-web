---
/**
 * Pie: baldosa índigo opaca rematada arriba por la cinta de módulos. Los enlaces externos (estado, devlog, repo)
 * solo aparecen si están definidos en site.links.
 * Términos, Uso aceptable y Privacidad son borradores de la beta (revisión del PAE pendiente). TODO(legal): DPA.
 */
import TileStrip from "./TileStrip.astro";
import Mark from "./Mark.astro";
import { site } from "../config/site";
import { fill, path, useDict, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useDict(lang);
const external = [
  { href: site.links.status, label: t.footer.status },
  { href: site.links.devlog, label: t.footer.devlog },
  { href: site.links.repo, label: t.footer.repo },
].filter((l): l is { href: string; label: string } => Boolean(l.href));
---
<TileStrip id="strip-footer" />
<footer class="footer band-indigo">
  <div class="container top">
    <div>
      <p class="word"><Mark size={96} class="word-mark" />{site.name}</p>
      <p class="tagline">{t.footer.tagline}</p>
    </div>
    <nav class="cols" aria-label={t.footer.tagline}>
      <ul>
        <li><a href={path("plans", lang)}>{t.nav.plans}</a></li>
        <li><a href={path("enterprise", lang)}>{t.nav.enterprise}</a></li>
        <li><a href={path("beta", lang)}>{t.footer.beta}</a></li>
        <li><a href={path("contact", lang)}>{t.nav.contact}</a></li>
        <li><a href={path("terms", lang)}>{t.footer.terms}</a></li>
        <li><a href={path("aup", lang)}>{t.footer.aup}</a></li>
        <li><a href={path("privacy", lang)}>{t.footer.privacy}</a></li>
        {external.map((l) => <li><a href={l.href} rel="noopener">{l.label}</a></li>)}
      </ul>
      <ul class="mail">
        <li><a href={`mailto:${site.email.hello}`}>{site.email.hello}</a></li>
        <li><span class="label">{t.contact.channels.supportLabel}</span><a href={`mailto:${site.email.support}`}>{site.email.support}</a></li>
        <li><span class="label">{t.contact.channels.abuseLabel}</span><a href={`mailto:${site.email.abuse}`}>{site.email.abuse}</a></li>
      </ul>
    </nav>
  </div>
  <div class="container legal">
    <p>{fill(t.footer.rights, { year: new Date().getFullYear(), name: site.name })}</p>
  </div>
</footer>

<style>
  /* Pie en noche profunda: la banda cobalto ya está en los pasos y el cierre es ámbar; aquí descansa el color */
  .footer { background: var(--pool-base); padding-block: clamp(3rem, 6vw, 5rem) 2rem; font-size: var(--step--1); }
  .top { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 3rem; align-items: end; }
  .word {
    font-family: var(--font-display);
    font-stretch: 68%;
    font-weight: 800;
    font-size: var(--step-4);
    line-height: 0.85;
    display: flex;
    align-items: flex-end;
    gap: 0.18em;
  }
  .word :global(.word-mark) { width: 0.82em; height: 0.82em; flex: none; }
  .tagline { margin-top: 1rem; color: var(--muted); max-width: 32ch; font-size: var(--step-0); }
  .cols { display: grid; grid-template-columns: 1fr 1.5fr; gap: 2rem; }
  ul { list-style: none; padding: 0; display: grid; gap: 0.6rem; }
  a { color: var(--white); }
  .mail a { font-family: var(--font-mono); }
  .label { display: block; color: var(--muted); }
  /* Táctil: cada enlace del pie ocupa al menos 44 px de alto */
  @media (pointer: coarse) {
    ul { gap: 0; }
    .cols a { display: inline-flex; align-items: center; min-height: 44px; }
  }
  .legal { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--rule-color); color: var(--muted); }
  @media (max-width: 767px) {
    .top { grid-template-columns: 1fr; gap: 2rem; }
    .cols { grid-template-columns: 1fr; }
  }
</style>
