---
/**
 * Formulario de contacto / reserva de beta.
 * - Envía JSON a POST /api/contact (worker/index.ts), que re-valida TODO y verifica Turnstile en servidor.
 * - Lee ?motivo= y ?plan= de la URL para preseleccionar (los CTAs de la web los ponen).
 * - Estados: validación inline, enviando, error de servidor, éxito. Sin alert().
 * - Los mensajes van en data-messages (JSON) para no usar scripts inline (CSP estricta).
 * - Props opcionales para /beta: `reason` fija el motivo (campo oculto, sin selector) y `copy` cambia título,
 *   ayuda del mensaje, botón y mensaje de éxito. Sin props se comporta como siempre (/contacto).
 * - Si la URL trae ?utm_source= (enlaces cortos de los QR, public/_redirects), se añade "Origen: ..." al final del
 *   mensaje. Así sabemos el canal sin tocar el Worker ni añadir campos.
 * - Campo opcional "ID de referido": solo con motivo "beta" (siempre visible en /beta; en /contacto aparece al elegir
 *   ese motivo). No se valida contra una lista: llega en el asunto y el cuerpo del correo y se cuenta a mano.
 * IA: si añades un campo, añádelo también a la validación de worker/index.ts (mismos límites).
 */
import { plans } from "../config/plans";
import { site } from "../config/site";
import { fill, path, useDict, type Lang } from "../i18n";

type Reason = keyof ReturnType<typeof useDict>["contact"]["form"]["reasons"];
interface Props {
  lang: Lang;
  /** Motivo fijo: oculta el selector de motivo y envía este valor. */
  reason?: Reason;
  /** Textos que cambian respecto a /contacto. title: null = sin título dentro del formulario. */
  copy?: { title?: string | null; message?: string; messageHelp?: string; submit?: string; success?: string };
}
const { lang, reason: fixedReason, copy = {} } = Astro.props;
const t = useDict(lang);
const f = { ...t.contact.form, ...Object.fromEntries(Object.entries(copy).filter(([, v]) => v !== undefined)) };
const formTitle = copy.title === null ? null : (copy.title ?? t.contact.form.title);
const reasons = Object.entries(f.reasons) as [keyof typeof f.reasons, string][];
const messages = JSON.stringify({
  ...f.errors,
  server: fill(f.errors.server, { email: site.email.hello }),
  success: f.success,
  sending: f.sending,
  submit: f.submit,
});
---
<form class="form" id="form" novalidate data-contact-form data-messages={messages} data-lang={lang}>
  {formTitle && <h2 class="form-title">{formTitle}</h2>}

  <div class="row">
    <div class="field">
      <label for="cf-name">{f.name}</label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required maxlength="100" aria-describedby="cf-name-err" />
      <p class="error" id="cf-name-err" data-error-for="name" hidden></p>
    </div>
    <div class="field">
      <label for="cf-email">{f.email}</label>
      <input id="cf-email" name="email" type="email" autocomplete="email" required maxlength="254" aria-describedby="cf-email-help cf-email-err" />
      <p class="help" id="cf-email-help">{f.emailHelp}</p>
      <p class="error" id="cf-email-err" data-error-for="email" hidden></p>
    </div>
  </div>

  <div class:list={["row", { "row--single": fixedReason }]}>
    {fixedReason ? (
      <input type="hidden" name="reason" value={fixedReason} />
    ) : (
      <div class="field">
        <label for="cf-reason">{f.reason}</label>
        <select id="cf-reason" name="reason">
          {reasons.map(([value, label]) => <option value={value}>{label}</option>)}
        </select>
      </div>
    )}
    <div class="field">
      <label for="cf-plan">{f.plan}</label>
      <select id="cf-plan" name="plan">
        <option value="">{f.planUnknown}</option>
        {plans.map((p) => <option value={p.id}>{t.plans.items[p.id].name}</option>)}
      </select>
    </div>
  </div>

  {(!fixedReason || fixedReason === "beta") && (
    <div class="field" data-referral hidden={fixedReason !== "beta"}>
      <label for="cf-referral">{f.referral}</label>
      <input id="cf-referral" name="referral" type="text" maxlength="32" autocomplete="off" autocapitalize="none" spellcheck="false" aria-describedby="cf-referral-help" />
      <p class="help" id="cf-referral-help">{f.referralHelp}</p>
    </div>
  )}

  <div class="field">
    <label for="cf-message">{f.message}</label>
    <textarea id="cf-message" name="message" rows="5" required minlength="10" maxlength="4000" aria-describedby="cf-message-help cf-message-err"></textarea>
    <p class="help" id="cf-message-help">{f.messageHelp}</p>
    <p class="error" id="cf-message-err" data-error-for="message" hidden></p>
  </div>

  <!-- Trampa para bots: los humanos no la ven. Si llega rellena, el Worker descarta en silencio. -->
  <div class="hp" aria-hidden="true">
    <label for="cf-website">Website</label>
    <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="turnstile">
    <div class="cf-turnstile" data-sitekey={site.turnstileSiteKey} data-language={lang} data-theme="auto"></div>
    <p class="error" data-error-for="turnstile" hidden></p>
  </div>

  <div class="submit-row">
    <button class="btn" type="submit" data-submit>{f.submit}</button>
    <p class="help">{f.privacy} <a href={path("privacy", lang)}>{f.privacyLink}</a></p>
  </div>
  <p class="error form-error" data-error-for="form" role="alert" hidden></p>
</form>

<div class="success band-sand" data-success tabindex="-1" role="status" hidden>
  <p data-success-text></p>
</div>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<style>
  .form {
    padding: clamp(1.4rem, 3vw, 2.4rem);
    display: grid;
    gap: 1.4rem;
    scroll-margin-top: calc(var(--nav-h) + 1rem);
    border: var(--rule);
    background: var(--paper-2);
  }
  .form-title { font-size: var(--step-2); }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem; }
  .row--single { grid-template-columns: 1fr; }
  .field { display: grid; gap: 0.4rem; align-content: start; }
  label { font-weight: 600; font-size: 0.95rem; }
  input, select, textarea {
    width: 100%;
    min-height: 52px;
    padding: 0.7rem 0.9rem;
    border-radius: 0;
    border: 2px solid var(--text);
    background: var(--paper);
    color: var(--text);
  }
  textarea { resize: vertical; min-height: 8rem; line-height: 1.5; }
  input:focus-visible, select:focus-visible, textarea:focus-visible { outline-offset: 0; }
  [aria-invalid="true"] { border-color: var(--brick); box-shadow: inset 0 -4px 0 var(--brick); }
  .help { font-size: var(--step--1); color: var(--muted); }
  .error { font-size: var(--step--1); color: var(--brick); font-weight: 600; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .turnstile { min-height: 65px; }
  .submit-row { display: flex; align-items: center; gap: 1rem 1.5rem; flex-wrap: wrap; }
  .btn[disabled] { opacity: 0.7; cursor: progress; }
  .success {
    padding: clamp(1.5rem, 3vw, 2.4rem);
    font-family: var(--font-display);
    font-stretch: var(--display-width);
    font-weight: 800;
    font-size: var(--step-2);
    line-height: 1;
  }
  @media (max-width: 767px) {
    .row { grid-template-columns: 1fr; }
  }
</style>

<script>
  type Field = "name" | "email" | "message" | "turnstile" | "form";
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");

  if (form) {
    const msg = JSON.parse(form.dataset.messages ?? "{}") as Record<string, string>;
    const submit = form.querySelector<HTMLButtonElement>("[data-submit]")!;
    const success = document.querySelector<HTMLElement>("[data-success]")!;
    const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

    // Preselección desde la URL (?motivo=beta&plan=developer)
    const q = new URLSearchParams(location.search);
    const setSelect = (name: string, value: string | null) => {
      const el = form.elements.namedItem(name);
      // Con motivo fijo, "reason" es un input oculto y no se toca.
      if (el instanceof HTMLSelectElement && value && [...el.options].some((o) => o.value === value)) el.value = value;
    };
    setSelect("reason", q.get("motivo"));
    setSelect("plan", q.get("plan"));
    // Canal de llegada (QR). Solo letras, números, _ y -: nunca se pega texto arbitrario de la URL al correo.
    const src = q.get("utm_source");
    const origin = src && /^[\w-]{1,32}$/.test(src) ? `\n\nOrigen: ${src}` : "";

    // ID de referido: solo con motivo "beta". Se limpia al escribir y solo se envía si el motivo es beta.
    const refField = form.querySelector<HTMLElement>("[data-referral]");
    const refInput = form.querySelector<HTMLInputElement>("#cf-referral");
    const syncReferral = () => {
      if (refField) refField.hidden = new FormData(form).get("reason") !== "beta";
    };
    form.addEventListener("change", syncReferral);
    refInput?.addEventListener("input", () => {
      const v = refInput.value.replace(/[^\w-]/g, "");
      if (v !== refInput.value) refInput.value = v;
    });
    syncReferral();

    const showError = (field: Field, text: string | null) => {
      const p = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
      const input = form.elements.namedItem(field) as HTMLElement | null;
      if (p) {
        p.textContent = text ?? "";
        p.hidden = !text;
      }
      if (input && "setAttribute" in input) input.setAttribute("aria-invalid", text ? "true" : "false");
    };

    const validate = (data: FormData): Field | null => {
      const name = String(data.get("name") ?? "").trim();
      const email = String(data.get("email") ?? "").trim();
      const message = String(data.get("message") ?? "").trim();
      const token = String(data.get("cf-turnstile-response") ?? "");
      let first: Field | null = null;
      const check = (field: Field, bad: boolean, text: string) => {
        showError(field, bad ? text : null);
        if (bad && !first) first = field;
      };
      check("name", name.length < 1 || name.length > 100, msg.name);
      check("email", !EMAIL.test(email) || email.length > 254, msg.email);
      check("message", message.length < 10 || message.length > 4000, msg.message);
      check("turnstile", token.length === 0, msg.turnstile);
      return first;
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      showError("form", null);
      const data = new FormData(form);
      const invalid = validate(data);
      if (invalid) {
        (form.elements.namedItem(invalid) as HTMLElement | null)?.focus();
        return;
      }

      submit.disabled = true;
      submit.textContent = msg.sending;
      try {
        const res = await fetch("/api/contact", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            name: data.get("name"),
            email: data.get("email"),
            reason: data.get("reason"),
            plan: data.get("plan"),
            referral: data.get("reason") === "beta" ? String(data.get("referral") ?? "").trim() : "",
            message: (() => {
              const m = String(data.get("message") ?? "").trim();
              return m.length + origin.length <= 4000 ? m + origin : m;
            })(),
            website: data.get("website"),
            token: data.get("cf-turnstile-response"),
            lang: form.dataset.lang,
          }),
        });
        const body = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };
        if (res.ok && body.ok) {
          const email = String(data.get("email"));
          success.querySelector("[data-success-text]")!.textContent = msg.success.replace("{email}", email);
          form.hidden = true;
          success.hidden = false;
          success.focus();
          return;
        }
        const key = body.error === "turnstile" ? "turnstile" : body.error === "rate_limited" ? "rateLimited" : "server";
        showError(key === "turnstile" ? "turnstile" : "form", msg[key]);
      } catch {
        showError("form", msg.server);
      } finally {
        submit.disabled = false;
        submit.textContent = msg.submit;
        // Un token de Turnstile solo vale una vez: pedimos otro.
        (window as unknown as { turnstile?: { reset: () => void } }).turnstile?.reset();
      }
    });
  }
</script>
