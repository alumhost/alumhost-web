---
/**
 * Logo de WingIT (provisional, 29/10/2026): un azulejo. Baldosa añil con dos cuartos de círculo de albero en
 * esquinas opuestas y un rombo de cal en el centro, la misma pieza que la cinta de módulos (TileStrip).
 * Colores fijos de marca (no currentColor): el azulejo se ve igual sobre la pared, el añil o el albero.
 * Misma forma que public/favicon.svg.
 */
interface Props { size?: number; class?: string }
const { size = 28, class: className } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false" class:list={["mark", className]}>
  <rect width="64" height="64" fill="#1C3A8C"/>
  <path d="M0 0h28a28 28 0 0 1-28 28zM64 64H36a28 28 0 0 1 28-28z" fill="#E3A92F"/>
  <path d="M32 17 47 32 32 47 17 32z" fill="#F7F5F0"/>
  <path d="M32 25 39 32 32 39 25 32z" fill="#1C3A8C"/>
</svg>
