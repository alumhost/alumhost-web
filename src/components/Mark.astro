---
/**
 * Logo de AlumHost: persona con una terminal (>_) en el cuerpo (decisión 30/09/2026, idea de Blas).
 * Transparente (sin baldosa): la figura usa currentColor, así hereda el color del texto de donde esté
 * (crema sobre la noche, tinta sobre la banda ámbar). La pantalla es terracota de marca y el prompt crema fijo.
 * Misma forma que docs/marca/alumhost-horizontal-oscuro.svg. El favicon (public/favicon.svg) conserva la
 * baldosa crema porque las pestañas del navegador pueden ser claras u oscuras.
 */
interface Props { size?: number; class?: string }
const { size = 28, class: className } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 64 78" aria-hidden="true" focusable="false" class:list={["mark", className]}>
  <circle cx="32" cy="12" r="11" fill="currentColor"/>
  <rect x="4" y="29" width="56" height="46" rx="7" fill="currentColor"/>
  <rect x="11" y="36" width="42" height="30" rx="3" fill="#B4533A"/>
  <path d="M19 44 L27 51 L19 58" fill="none" stroke="#F4EBD9" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M31 58 H43" stroke="#F4EBD9" stroke-width="4" stroke-linecap="round"/>
</svg>
