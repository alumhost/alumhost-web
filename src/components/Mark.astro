---
/**
 * Marca geométrica provisional: cuatro baldosas 2x2 con cuartos de círculo (motivo de azulejo).
 * TODO(marca): sustituir por el logo definitivo. El mismo dibujo está en public/favicon.svg.
 */
interface Props { size?: number }
const { size = 28 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false" class="mark">
  <rect width="32" height="32" fill="var(--azulejo)" />
  <rect x="16" width="16" height="16" fill="var(--sobre-azulejo)" />
  <rect y="16" width="16" height="16" fill="var(--sobre-azulejo)" />
  <path d="M0 0h16a16 16 0 0 1-16 16z" fill="var(--sobre-azulejo)" />
  <path d="M32 32H16a16 16 0 0 1 16-16z" fill="var(--sobre-azulejo)" />
  <path d="M16 0a16 16 0 0 1 16 16H16z" fill="var(--azulejo)" />
  <path d="M16 32a16 16 0 0 1-16-16h16z" fill="var(--azulejo)" />
</svg>
