---
/**
 * Marca geométrica provisional: un azulejo visto desde arriba con la fuente en el centro.
 * TODO(marca): sustituir por el logo definitivo cuando exista. El mismo dibujo está en public/favicon.svg.
 */
interface Props { size?: number }
const { size = 28 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false" class="mark">
  <rect x="1" y="1" width="30" height="30" rx="9" fill="var(--azulejo)" />
  <rect x="7" y="7" width="18" height="18" rx="4" fill="none" stroke="var(--sobre-azulejo)" stroke-width="2" opacity="0.55" />
  <circle cx="16" cy="16" r="4.5" fill="var(--sobre-azulejo)" />
</svg>
