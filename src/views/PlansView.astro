---
/**
 * Planes como libro de cuentas: una fila ancha por plan (no tres tarjetas). El recomendado va a sangre sobre albero.
 * Todo precio sale de config/plans.ts (IVA calculado ahí). Interruptor anual/mensual sin JS (:has()).
 * Cada fila tiene id = plan.id para que el selector del hero enlace a /planes#developer, etc.
 */
import Base from "../layouts/Base.astro";
import { addons, formatEur, plans, withVat } from "../config/plans";
import { primaryCta } from "../config/cta";
import { priceView, specLines } from "../lib/planText";
import { fill, useDict, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useDict(lang);
const p = t.plans;
const backupPlans = plans.filter((pl) => pl.backup !== null);
---
<Base lang={lang} page="plans">
  <div class="plans-page">
    <header class="container head">
      <h1 class="rise" style="--i:0">{p.header.title}</h1>
      <div class="head-row rise" style="--i:1">
        <p class="lead">{p.header.sub}</p>
        <fieldset class="billing">
          <legend class="sr-only">{p.billing.label}</legend>
          <label>
            <input type="radio" name="billing" value="yearly" checked />
            <span>{p.billing.yearly}</span>
          </label>
          <label>
            <input type="radio" name="billing" value="monthly" />
            <span>{p.billing.monthly}</span>
          </label>
        </fieldset>
      </div>
    </header>

    <section class="rows" aria-label={t.nav.plans}>
      {plans.map((plan) => {
        const yearly = priceView(plan, "yearly", lang);
        const monthly = priceView(plan, "monthly", lang);
        const cta = primaryCta(lang, plan.id);
        const item = p.items[plan.id];
        return (
          <article id={plan.id} class:list={["plan", { "band-albero": plan.featured }]} aria-labelledby={`${plan.id}-name`}>
            <div class="container plan-in">
              <div class="who">
                {plan.featured && <p class="flag mono"><span class="sq" aria-hidden="true"></span>{p.recommended}</p>}
                <h2 id={`${plan.id}-name`}>{item.name}</h2>
                <p class="tagline muted">{item.tagline}</p>
              </div>

              <ul class="features">
                {specLines(plan, lang).map((line) => <li>{line}</li>)}
              </ul>

              <div class="buy">
                <div class="price price--yearly">
                  <p class="line"><span class="amount">{yearly.monthly}</span><span class="per">{t.common.perMonth}</span></p>
                  <p class="note muted">{yearly.note}</p>
                </div>
                <div class="price price--monthly">
                  <p class="line"><span class="amount">{monthly.monthly}</span><span class="per">{t.common.perMonth}</span></p>
                  <p class="note muted">{monthly.note}</p>
                </div>
                <a class="btn" href={cta.href}>{cta.label}</a>
              </div>
            </div>
          </article>
        );
      })}
    </section>

    <section class="section container extras" aria-labelledby="addons-title">
      <h2 id="addons-title">{p.addons.title}</h2>
      <div class="extras-grid">
        <div class="extra">
          <h3>{p.addons.backup.title}</h3>
          <ul class="backup-lines">
            {backupPlans.map((pl) => (
              <li>
                {fill(p.addons.backup.line, {
                  price: formatEur(withVat(pl.backup!.monthly), lang),
                  plan: p.items[pl.id].name,
                  days: pl.backup!.retentionDays,
                })}
              </li>
            ))}
          </ul>
          <p class="muted">{p.addons.backup.note}</p>
        </div>
        <div class="extra">
          <h3>{p.addons.ipv4.title}</h3>
          <p class="muted">{fill(p.addons.ipv4.body, { price: formatEur(withVat(addons.dedicatedIpv4.monthly), lang) })}</p>
        </div>
      </div>
    </section>

    <section class="container faq" aria-labelledby="faq-title">
      <h2 id="faq-title">{p.faq.title}</h2>
      <div class="faq-list">
        {p.faq.items.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p class="muted">{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</Base>

<style>
  .head { padding-top: clamp(3rem, 6vw, 5.5rem); padding-bottom: clamp(2rem, 4vw, 3.5rem); }
  .head h1 { font-size: var(--step-4); max-width: 13ch; }
  .head-row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  /* Interruptor anual / mensual: dos palabras en un marco rectangular */
  .billing {
    display: inline-grid;
    grid-template-columns: 1fr 1fr;
    border: var(--rule);
  }
  .billing label { position: relative; }
  .billing input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .billing span {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    min-width: 8rem;
    padding: 0 1.2rem;
    font-weight: 600;
    transition: background-color 160ms var(--ease), color 160ms var(--ease);
  }
  .billing input:checked + span { background: var(--tinta); color: var(--cal); }
  .billing input:focus-visible + span { outline: 3px solid var(--focus); outline-offset: 3px; }

  .price--monthly { display: none; }
  .plans-page:has(input[name="billing"][value="monthly"]:checked) .price--monthly { display: block; }
  .plans-page:has(input[name="billing"][value="monthly"]:checked) .price--yearly { display: none; }

  /* Filas de plan */
  .plan { border-top: var(--rule); scroll-margin-top: var(--nav-h); }
  .plan:last-child { border-bottom: var(--rule); }
  .plan-in {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 4fr) minmax(0, 4fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
    padding-block: clamp(1.8rem, 3.5vw, 3rem);
  }
  .flag {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.8rem;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .sq { width: 10px; height: 10px; background: currentColor; }
  .who h2 { font-size: var(--step-3); }
  .tagline { margin-top: 0.8rem; max-width: 30ch; }
  .features { list-style: none; padding: 0; display: grid; gap: 0.55rem; }
  .features li { display: grid; grid-template-columns: 10px 1fr; gap: 0.8rem; align-items: baseline; }
  .features li::before { content: ""; width: 8px; height: 8px; background: currentColor; translate: 0 -1px; }
  .buy { display: grid; gap: 1.4rem; justify-items: start; }
  .line { display: flex; align-items: baseline; gap: 0.3rem; }
  .amount {
    font-family: var(--font-display);
    font-stretch: var(--display-width);
    font-weight: 800;
    font-size: var(--step-4);
    line-height: 0.85;
    font-variant-numeric: tabular-nums;
  }
  .per { color: var(--muted); font-weight: 600; }
  .note { font-size: var(--step--1); margin-top: 0.5rem; }

  /* Extras */
  .extras h2, .faq h2 { font-size: var(--step-3); margin-bottom: clamp(1.5rem, 3vw, 2.5rem); }
  .extras-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 5rem); }
  .extra { border-top: var(--rule); padding-top: 1.2rem; }
  .extra h3 { font-size: var(--step-2); font-stretch: var(--display-width); font-weight: 800; margin-bottom: 0.8rem; }
  .extra p + p { margin-top: 0.4rem; }
  .backup-lines { list-style: none; padding: 0; display: grid; gap: 0.3rem; margin-bottom: 0.8rem; font-weight: 600; }

  /* Preguntas */
  .faq { padding-bottom: var(--section); }
  .faq-list { border-bottom: var(--rule); }
  details { border-top: var(--rule); }
  summary {
    cursor: pointer;
    list-style: none;
    padding: 1.2rem 3rem 1.2rem 0;
    font-size: var(--step-1);
    font-weight: 600;
    position: relative;
    min-height: 44px;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: "+";
    position: absolute;
    right: 0;
    top: 50%;
    translate: 0 -50%;
    font-family: var(--font-mono);
    font-size: 1.6rem;
    transition: rotate 200ms var(--ease);
  }
  details[open] summary::after { rotate: 45deg; }
  details p { padding: 0 3rem 1.4rem 0; max-width: 60ch; }

  @media (max-width: 919px) {
    .plan-in { grid-template-columns: 1fr 1fr; }
    .buy { grid-column: 1 / -1; grid-template-columns: 1fr auto; align-items: end; }
  }
  @media (max-width: 639px) {
    .plan-in { grid-template-columns: 1fr; }
    .buy { grid-template-columns: 1fr; }
    .extras-grid { grid-template-columns: 1fr; }
  }
</style>
