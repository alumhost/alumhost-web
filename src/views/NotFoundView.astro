---
import Base from "../layouts/Base.astro";
import { path, useDict, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useDict(lang);
const en = useDict("en");
---
<Base lang={lang} page="notFound">
  <div class="veil">
  <section class="container nf">
    <p class="code" aria-hidden="true">404</p>
    <div data-nf-en={JSON.stringify({ title: en.notFound.title, body: en.notFound.body, back: en.notFound.back, home: path("home", "en"), doc: en.meta.notFound.title.replace("{name}", "AlumHost") })}>
      <h1 data-nf="title">{t.notFound.title}</h1>
      <p class="lead" data-nf="body">{t.notFound.body}</p>
      <a class="btn" data-nf="back" href={path("home", lang)}>{t.notFound.back}</a>
    </div>
  </section>
  </div>
</Base>

<script>
  // Cloudflare sirve un único 404.html para todo el sitio: bajo /en/ lo pasamos a inglés en el navegador.
  const box = document.querySelector<HTMLElement>("[data-nf-en]");
  if (box && (location.pathname === "/en" || location.pathname.startsWith("/en/"))) {
    const d = JSON.parse(box.dataset.nfEn ?? "{}") as { title: string; body: string; back: string; home: string; doc: string };
    document.documentElement.lang = "en";
    document.title = d.doc;
    const setText = (key: string, value: string) => {
      const el = box.querySelector(`[data-nf="${key}"]`);
      if (el) el.textContent = value;
    };
    setText("title", d.title);
    setText("body", d.body);
    const a = box.querySelector<HTMLAnchorElement>('[data-nf="back"]');
    if (a) {
      a.textContent = d.back;
      a.href = d.home;
    }
  }
</script>

<style>
  .nf {
    min-height: 70dvh;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-block: clamp(3rem, 6vw, 5rem);
  }
  .code {
    font-family: var(--font-display);
    font-stretch: 62%;
    font-weight: 900;
    font-size: clamp(9rem, 30vw, 26rem);
    line-height: 0.8;
    color: var(--link);
  }
  h1 { font-size: var(--step-3); }
  .lead { margin: 1rem 0 2rem; }
  @media (max-width: 767px) {
    .nf { grid-template-columns: 1fr; }
  }
</style>
