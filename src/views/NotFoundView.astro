---
import Base from "../layouts/Base.astro";
import { path, useDict, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useDict(lang);
---
<Base lang={lang} page="notFound">
  <section class="container nf">
    <p class="code" aria-hidden="true">404</p>
    <div>
      <h1>{t.notFound.title}</h1>
      <p class="lead">{t.notFound.body}</p>
      <a class="btn" href={path("home", lang)}>{t.notFound.back}</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 70dvh;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-block: clamp(3rem, 6vw, 5rem);
  }
  .code {
    font-family: var(--font-display);
    font-stretch: 62%;
    font-weight: 900;
    font-size: clamp(9rem, 30vw, 26rem);
    line-height: 0.8;
    color: var(--link);
  }
  h1 { font-size: var(--step-3); }
  .lead { margin: 1rem 0 2rem; }
  @media (max-width: 767px) {
    .nf { grid-template-columns: 1fr; }
  }
</style>
