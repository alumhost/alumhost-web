---
/**
 * Home. Secciones (cada una con un layout distinto, regla anti-plantilla):
 * 1 hero partido (texto + selector real) · 2 bento asimétrico · 3 pasos en fila · 4 lista honesta · 5 cierre beta.
 * Textos: i18n home.*. CTA: primaryCta() (depende de site.salesMode).
 */
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import PlanPicker from "../components/PlanPicker.astro";
import { primaryCta } from "../config/cta";
import { path, useDict, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useDict(lang);
const h = t.home;
const cta = primaryCta(lang);
const [perkPerson, perkUni, perkPrice, perkOpen] = h.perks.items;
---
<Base lang={lang} page="home">
  <!-- 1. HERO -->
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow rise" style="--i:0">{h.hero.eyebrow}</p>
      <h1 class="rise" style="--i:1">{h.hero.titleA} <em>{h.hero.titleEm}</em></h1>
      <p class="lead rise" style="--i:2">{h.hero.sub}</p>
      <div class="ctas rise" style="--i:3">
        <a class="btn btn--primary" href={cta.href}>{cta.label}</a>
        <a class="btn btn--ghost" href={path("plans", lang)}>{h.hero.ctaSecondary}</a>
      </div>
    </div>
    <div class="hero-picker rise" style="--i:2">
      <PlanPicker lang={lang} />
    </div>
  </section>

  <!-- 2. BENTO: por qué nosotros -->
  <section class="section container" aria-labelledby="perks-title">
    <h2 id="perks-title" class="section-title" data-reveal>{h.perks.title}</h2>
    <div class="bento">
      <article class="cell cell--person glass" data-reveal style="--i:0">
        <Icon name="handshake" size="2.2rem" class="cell-icon" />
        <h3>{perkPerson.title}</h3>
        <p class="muted">{perkPerson.body}</p>
      </article>
      <article class="cell cell--uni" data-reveal style="--i:1">
        <Icon name="graduation-cap" size="2rem" class="cell-icon" />
        <h3>{perkUni.title}</h3>
        <p class="muted">{perkUni.body}</p>
      </article>
      <article class="cell cell--price" data-reveal style="--i:2">
        <h3>{perkPrice.title}</h3>
        <p>{perkPrice.body}</p>
      </article>
      <article class="cell cell--open glass" data-reveal style="--i:3">
        <div>
          <Icon name="git-branch" size="2rem" class="cell-icon" />
          <h3>{perkOpen.title}</h3>
          <p class="muted">{perkOpen.body}</p>
        </div>
        <!-- Nombres reales de los scripts del plan (§6). No inventar flags ni salidas. -->
        <ul class="scripts mono" aria-label="Scripts">
          <li>./create-vps</li>
          <li>./destroy-vps</li>
          <li>./quarantine-vps</li>
        </ul>
      </article>
    </div>
  </section>

  <!-- 3. PASOS (secuencia real: aquí sí tiene sentido numerar) -->
  <section class="section container" aria-labelledby="steps-title">
    <h2 id="steps-title" class="section-title" data-reveal>{h.steps.title}</h2>
    <ol class="steps">
      {h.steps.items.map((s, i) => (
        <li data-reveal style={`--i:${i}`}>
          <span class="step-n mono" aria-hidden="true">{i + 1}</span>
          <h3 class="step-verb">{s.verb}</h3>
          <p class="muted">{s.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- 4. HONESTIDAD -->
  <section class="section container honest" aria-labelledby="honest-title">
    <h2 id="honest-title" class="honest-title" data-reveal>{h.honest.title}</h2>
    <ul class="honest-list">
      {h.honest.items.map((it, i) => (
        <li data-reveal style={`--i:${i}`}>
          <Icon name="warning-octagon" size="1.4rem" class="honest-icon" />
          <p><strong>{it.title}</strong> <span class="muted">{it.body}</span></p>
        </li>
      ))}
    </ul>
  </section>

  <!-- 5. CIERRE -->
  <section class="container closing-wrap">
    <div class="closing" data-reveal>
      <div>
        <h2>{h.closing.title}</h2>
        <p class="muted">{h.closing.body}</p>
      </div>
      <a class="btn btn--primary" href={cta.href}>{cta.label}</a>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
    min-height: min(92dvh, 780px);
    padding-top: 8rem;
    padding-bottom: 4rem;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--pizarra);
    margin-bottom: 1.4rem;
  }
  .eyebrow::before { content: ""; width: 10px; height: 10px; background: var(--azulejo); }
  h1 { max-width: 16ch; }
  h1 em { font-style: normal; color: var(--azulejo); }
  .hero .lead { margin-top: 1.4rem; }
  .ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2.2rem; }

  @media (prefers-reduced-motion: no-preference) {
    .rise {
      animation: rise 900ms var(--ease) both;
      animation-delay: calc(120ms + var(--i, 0) * 90ms);
    }
    @keyframes rise {
      from { opacity: 0; transform: translateY(22px); }
    }
  }

  .section-title { margin-bottom: clamp(1.8rem, 3vw, 2.8rem); max-width: 20ch; }

  /* ---------- Bento ---------- */
  .bento {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: minmax(190px, auto);
    gap: 1rem;
  }
  .cell {
    border-radius: var(--r-panel);
    padding: clamp(1.4rem, 2.5vw, 2.2rem);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .cell h3 { font-size: var(--step-2); max-width: 18ch; }
  .cell p { max-width: 46ch; }
  :global(.cell-icon) { color: var(--azulejo); margin-bottom: auto; padding-bottom: 1.2rem; box-sizing: content-box; }

  .cell--person { grid-column: span 7; grid-row: span 2; justify-content: flex-end; }
  .cell--person h3 { font-size: var(--step-3); }
  .cell--uni {
    grid-column: span 5;
    background: color-mix(in srgb, var(--cal-hondo) 85%, transparent);
    border: 1px solid var(--glass-border);
  }
  .cell--price {
    grid-column: span 5;
    justify-content: flex-end;
    background:
      radial-gradient(120% 120% at 100% 0%, color-mix(in srgb, var(--sobre-azulejo) 16%, transparent), transparent 55%),
      var(--azulejo);
    color: var(--sobre-azulejo);
  }
  .cell--open {
    grid-column: span 12;
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }
  .scripts {
    list-style: none;
    padding: 1rem 1.2rem;
    border-radius: var(--r-card);
    background: var(--code-bg);
    color: var(--code-fg);
    border: 1px solid var(--glass-border);
    font-size: 0.9rem;
    line-height: 1.9;
    min-width: 15rem;
  }
  .scripts li::before { content: "$ "; opacity: 0.55; }

  /* ---------- Pasos ---------- */
  .steps {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
  }
  .steps li { border-top: 1px solid color-mix(in srgb, var(--tinta) 18%, transparent); padding-top: 1.4rem; }
  .step-n { color: var(--azulejo); font-size: 0.9rem; }
  .step-verb { font-size: var(--step-3); margin: 0.4rem 0 0.7rem; }

  /* ---------- Honestidad ---------- */
  .honest {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .honest-title { position: sticky; top: 7rem; max-width: 14ch; }
  .honest-list { list-style: none; padding: 0; display: grid; gap: 1.6rem; }
  .honest-list li { display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: start; }
  :global(.honest-icon) { color: var(--azulejo); margin-top: 0.15rem; }
  .honest-list strong { font-weight: 620; }

  /* ---------- Cierre ---------- */
  .closing-wrap { padding-top: calc(var(--section) * 0.5); }
  .closing {
    background: var(--azulejo);
    color: var(--sobre-azulejo);
    border-radius: var(--r-panel);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.8rem, 4vw, 3.2rem);
  }
  .closing h2 { font-size: var(--step-3); max-width: 18ch; }
  .closing .muted { color: inherit; opacity: 0.9; }
  .closing .btn--primary { background: var(--sobre-azulejo); color: var(--azulejo); box-shadow: none; }
  .closing .btn--primary:hover { background: var(--cal-hondo); color: var(--azulejo); }
  .closing p { margin-top: 0.8rem; max-width: 48ch; }

  /* ---------- Móvil ---------- */
  @media (max-width: 919px) {
    .hero { grid-template-columns: 1fr; min-height: auto; padding-top: 7.5rem; }
  }
  @media (max-width: 767px) {
    .bento { grid-template-columns: 1fr; grid-auto-rows: auto; }
    .cell--person, .cell--uni, .cell--price, .cell--open { grid-column: auto; grid-row: auto; }
    .cell--person { min-height: 280px; }
    .cell--open { flex-direction: column; align-items: stretch; }
    .steps { grid-template-columns: 1fr; }
    .honest { grid-template-columns: 1fr; }
    .honest-title { position: static; }
    .closing { flex-direction: column; align-items: flex-start; }
  }
</style>
