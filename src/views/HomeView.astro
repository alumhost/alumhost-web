---
/**
 * Portada. "Módulos sobre el agua": cada bloque usa un tratamiento distinto a propósito (no hay plantilla repetida).
 * 1 hero directamente sobre el agua (titular a cartel + selector de cristal) · cinta de módulos
 * · 2 cómo trabajamos: libro de filas sobre velo · 3 pasos: verbos gigantes en baldosa índigo con textura
 * · 1b vídeo explicativo (motion graphics) en marco opaco sobre velo
 * · 4 lo que NO prometemos, tachado, sobre velo · 5 cierre en baldosa arena.
 * Textos: i18n home.*. CTA: primaryCta() (depende de site.salesMode).
 * IA: los pasos no llevan números porque el orden ya lo da la lectura; no los añadas.
 */
import Base from "../layouts/Base.astro";
import TileStrip from "../components/TileStrip.astro";
import TileMotif from "../components/TileMotif.astro";
import PlanPicker from "../components/PlanPicker.astro";
import Mark from "../components/Mark.astro";
import Icon, { type IconName } from "../components/Icon.astro";
import { primaryCta } from "../config/cta";
import { path, useDict, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useDict(lang);
const h = t.home;
const cta = primaryCta(lang);
const [perkPerson, ...perkRest] = h.perks.items;
/* Un icono por hecho, en el orden de home.proof.items: IVA, euros, persona, precio congelado */
const proofIcons: IconName[] = ["receipt", "currency-eur", "chat-circle-text", "lock-simple"];
---
<Base lang={lang} page="home">
  <!-- 1. HERO: titular y selector lado a lado sobre el agua; debajo, los hechos que ya son verdad -->
  <section class="container hero">
    <div class="hero-copy">
      <p class="status mono prompt prompt--live rise" style="--i:0">{h.hero.eyebrow}</p>
      <h1 class="rise" style="--i:1">{h.hero.titleA} <em>{h.hero.titleEm}</em></h1>
      <div class="rise" style="--i:2">
        <p class="lead">{h.hero.sub}</p>
        <div class="ctas">
          <a class="btn" href={cta.href}>{cta.label}</a>
          <a class="textlink" href={path("plans", lang)}>{h.hero.ctaSecondary}</a>
        </div>
      </div>
    </div>
    <div class="hero-side rise" style="--i:3">
      <PlanPicker lang={lang} />
    </div>
    <div class="proof">
      <p class="proof-label mono">{h.proof.label}</p>
      <ul>
        {h.proof.items.map((it, i) => (
          <li>
            <strong><span class="proof-icon"><Icon name={proofIcons[i]} size="1.25em" /></span>{it.title}</strong>
            <span class="muted">{it.body}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <TileStrip id="strip-hero" />

  <!-- 1b. VÍDEO: no se reproduce solo (lleva sonido y pesa); preload="none" para no gastar datos hasta el clic -->
  <div class="veil">
    <section class="section container film" aria-labelledby="film-title">
      <div class="film-copy">
        <h2 id="film-title">{h.film.title}</h2>
        <p class="muted">{h.film.body}</p>
      </div>
      <figure class="film-frame">
        <video
          controls
          playsinline
          preload="none"
          poster="/video/alumhost-poster.jpg"
          width="1920"
          height="1080"
          aria-label={h.film.label}
        >
          <source src="/video/alumhost.webm" type="video/webm" />
          <source src="/video/alumhost.mp4" type="video/mp4" />
          <p>{h.film.fallback} <a href="/video/alumhost.mp4" download>{h.film.download}</a></p>
        </video>
      </figure>
    </section>
  </div>

  <!-- 2. CÓMO TRABAJAMOS: libro de filas -->
  <div class="veil">
    <section class="section container perks" aria-labelledby="perks-title">
      <h2 id="perks-title">{h.perks.title}</h2>
      <div class="rows">
        <article class="row row--lead">
          {/* El logo es literalmente "una persona con una terminal": aquí firma la promesa */}
          <Mark size={72} class="lead-mark" />
          <h3>{perkPerson.title}</h3>
          <p>{perkPerson.body}</p>
        </article>
        {perkRest.map((p, i) => (
          <article class="row">
            <h3>{p.title}</h3>
            <div>
              <p class="muted">{p.body}</p>
              {i === perkRest.length - 1 && (
                /* Nombres reales de los scripts del plan (§6). No inventar flags ni salidas. */
                <ul class="scripts mono" aria-label="Scripts">
                  <li>./create-vps</li>
                  <li>./destroy-vps</li>
                  <li>./quarantine-vps</li>
                </ul>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>

  <!-- 3. PASOS: tres verbos gigantes en baldosa índigo -->
  <section class="section steps band-indigo" aria-labelledby="steps-title">
    <TileMotif id="motif-steps" opacity={0.06} />
    <div class="container steps-in">
      <h2 id="steps-title">{h.steps.title}</h2>
      <ol class="steps-list">
        {h.steps.items.map((s) => (
          <li>
            <span class="verb">{s.verb}</span>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4. LO QUE NO PROMETEMOS: lo negado va tachado -->
  <div class="veil">
    <section class="section container honest" aria-labelledby="honest-title">
      <h2 id="honest-title">{h.honest.title}</h2>
      <ul class="honest-list">
        {h.honest.items.map((it) => (
          <li>
            <p class="denied"><s>{it.title}</s></p>
            <p class="muted">{it.body}</p>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <!-- 5. CIERRE en baldosa arena -->
  <section class="band-sand closing" aria-labelledby="closing-title">
    <div class="container closing-in">
      <h2 id="closing-title">{h.closing.title}</h2>
      <div>
        <p class="lead">{h.closing.body}</p>
        <a class="btn" href={cta.href}>{cta.label}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 4vw, 4.5rem);
    align-items: end;
    padding-block: clamp(2.5rem, 6vw, 5.5rem) clamp(2.5rem, 4vw, 3.5rem);
  }
  .hero h1 { font-size: var(--step-4); max-width: 11ch; margin-block: 1.2rem clamp(1.5rem, 2.5vw, 2.2rem); }
  .hero h1 em {
    font-style: normal;
    background: linear-gradient(var(--sand), var(--sand)) 0 90% / 100% 0.12em no-repeat;
  }
  .hero .lead { color: var(--text); max-width: 38ch; }
  .ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; margin-top: 2rem; }
  .status { font-size: 0.875rem; color: var(--teal); }

  /* Hechos: libro mayor bajo el hero, cuatro entradas separadas por reglas, cada marca con su color */
  .proof { grid-column: 1 / -1; border-top: var(--rule); padding-top: 1.1rem; }
  .proof-label { font-size: 0.8rem; color: var(--muted); letter-spacing: 0.04em; text-transform: uppercase; }
  .proof ul {
    list-style: none;
    padding: 0;
    margin-top: 0.9rem;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .proof li { display: grid; gap: 0.25rem; padding: 0.2rem 1.4rem 0.2rem 1.1rem; border-left: 1px solid var(--rule-color); }
  .proof li:first-child { border-left: 0; padding-left: 0; }
  .proof strong { display: flex; align-items: center; gap: 0.55rem; font-weight: 600; }
  .proof-icon { display: inline-flex; flex: none; color: var(--mark, var(--teal)); }
  .proof li:nth-child(2) { --mark: var(--sand); }
  .proof li:nth-child(3) { --mark: var(--sky); }
  .proof li:nth-child(4) { --mark: var(--white); }
  .proof .muted { font-size: var(--step--1); line-height: 1.45; }

  /* ---------- Vídeo ---------- */
  .film {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
  }
  .film h2 { max-width: 9ch; margin-bottom: 1.2rem; }
  .film-copy p { max-width: 32ch; }
  /* Marco opaco y recto (baldosa, no cristal): el vídeo no flota */
  .film-frame { margin: 0; background: var(--ink); border: var(--rule); }
  .film-frame video { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; background: var(--ink); }

  /* ---------- Libro de filas ---------- */
  .perks {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .perks h2 { position: sticky; top: calc(var(--nav-h) + 2.5rem); max-width: 8ch; }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(1rem, 4vw, 4rem);
    align-items: start;
    padding-block: clamp(1.4rem, 2.5vw, 2.2rem);
    border-top: var(--rule);
  }
  .row:first-child { padding-top: 0; border-top: 0; }
  .row:last-child { border-bottom: var(--rule); }
  /* Cada fila lleva su color en el arranque de la regla: ámbar, verde agua, azul */
  .row + .row::before {
    content: "";
    position: absolute;
    left: 0;
    top: -2px;
    width: 3.5rem;
    height: 2px;
    background: var(--accent);
  }
  .row:nth-child(2) { --accent: var(--sand); }
  .row:nth-child(3) { --accent: var(--teal); }
  .row:nth-child(4) { --accent: var(--sky); }
  .row h3 { font-stretch: var(--display-width); font-weight: 800; font-size: var(--step-2); line-height: 0.95; max-width: 14ch; }
  .row p { max-width: 46ch; }
  .row--lead { grid-template-columns: 1fr; gap: 1.2rem; }
  .row--lead h3 { font-size: var(--step-3); max-width: 12ch; }
  .row--lead :global(.lead-mark) { width: clamp(3.2rem, 2.4rem + 2.5vw, 4.5rem); height: auto; }
  .row--lead p { font-size: var(--step-1); line-height: 1.4; align-self: end; }
  .scripts {
    list-style: none;
    padding: 1rem 1.2rem;
    margin-top: 1.5rem;
    background: var(--ink);
    color: var(--text);
    line-height: 1.9;
    max-width: 22rem;
    border: 1px solid var(--rule-color);
  }
  .scripts li::before { content: "$ "; color: var(--teal); }

  /* ---------- Pasos ---------- */
  .steps { position: relative; overflow: hidden; }
  .steps-in { position: relative; }
  .steps h2 { margin-bottom: clamp(1.5rem, 3vw, 3rem); }
  .steps-list { list-style: none; padding: 0; }
  .steps-list li {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(1rem, 4vw, 4rem);
    align-items: end;
    padding-block: clamp(0.8rem, 1.5vw, 1.4rem);
    border-top: var(--rule);
  }
  .verb {
    color: var(--sand);
    font-family: var(--font-display);
    font-stretch: 68%;
    font-weight: 800;
    font-size: var(--step-4);
    line-height: 0.88;
    text-transform: uppercase;
  }
  .steps-list p { font-size: var(--step-1); line-height: 1.35; max-width: 30ch; }

  /* ---------- Lo que no prometemos ---------- */
  .honest h2 { margin-bottom: clamp(2rem, 4vw, 3.5rem); max-width: 14ch; }
  .honest-list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3.5rem) clamp(2rem, 5vw, 5rem);
  }
  .honest-list li { border-top: var(--rule); padding-top: 1.2rem; }
  .denied {
    font-family: var(--font-display);
    font-stretch: var(--display-width);
    font-weight: 800;
    font-size: var(--step-3);
    line-height: 0.95;
    margin-bottom: 0.8rem;
  }
  .denied s { text-decoration-color: var(--brick); text-decoration-thickness: 0.09em; }
  .honest-list .muted { max-width: 38ch; }

  /* ---------- Cierre ---------- */
  .closing { padding-block: var(--section); }
  .closing-in {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
  }
  .closing h2 { font-size: var(--step-4); }
  .closing .lead { margin-bottom: 1.6rem; }

  /* ---------- Móvil ---------- */
  @media (max-width: 919px) {
    .hero, .closing-in, .perks, .film { grid-template-columns: 1fr; }
    .perks h2 { position: static; max-width: 12ch; }
    .proof ul { grid-template-columns: 1fr 1fr; row-gap: 1.2rem; }
    .proof li:nth-child(3) { border-left: 0; padding-left: 0; }
  }
  @media (max-width: 767px) {
    .row, .steps-list li { grid-template-columns: 1fr; gap: 0.7rem; }
    .row--lead p { align-self: start; }
    .honest-list { grid-template-columns: 1fr; }
    .proof ul { grid-template-columns: 1fr; }
    .proof li { border-left: 0; padding-left: 0; }
  }
</style>
